# ─── LLM Provider ────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-7

# ─── OpenAI (fallback provider) ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# ─── Web Search ──────────────────────────────────────────────────────────────
# Get a free key at: https://tavily.com (1,000 searches/month free)
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=your_tavily_key_here

# ─── Code Execution ──────────────────────────────────────────────────────────
# Automatically runs Python code blocks written by the agent in data mode
# Requires python3 to be installed on your machine
# Set to false to disable auto-execution (agent will still write the code)
CODE_EXECUTION_ENABLED=true

# ─── Agent behaviour ─────────────────────────────────────────────────────────
AGENT_STYLE=professional
OUTPUT_FORMAT=markdown

# ─── Token limits ────────────────────────────────────────────────────────────
# MAX_TOKENS=4000

# ─── Extended Thinking ───────────────────────────────────────────────────────
# THINKING_BUDGET_TOKENS=10000
# LOG_THINKING=false

# ─── RAG ─────────────────────────────────────────────────────────────────────
RAG_ENABLED=true

# ─── Cost control ────────────────────────────────────────────────────────────
DAILY_BUDGET_USD=15.00
