# ─── LLM Provider ────────────────────────────────────────────────────────────
# Which AI provider to use: anthropic (default) or openai
LLM_PROVIDER=anthropic

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-7

# ─── OpenAI (fallback provider) ──────────────────────────────────────────────
# Only required if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here

# ─── Web Search ──────────────────────────────────────────────────────────────
# Enables live web search for queries about current prices, news, rates, etc.
# Get a free key at: https://tavily.com (1,000 searches/month free)
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=your_tavily_key_here

# ─── Agent behaviour ─────────────────────────────────────────────────────────
AGENT_STYLE=professional
OUTPUT_FORMAT=markdown

# ─── Token limits ────────────────────────────────────────────────────────────
# MAX_TOKENS=4000

# ─── Extended Thinking ───────────────────────────────────────────────────────
# THINKING_BUDGET_TOKENS=10000
# LOG_THINKING=false

# ─── RAG ─────────────────────────────────────────────────────────────────────
RAG_ENABLED=true

# ─── Cost control ────────────────────────────────────────────────────────────
DAILY_BUDGET_USD=15.00
