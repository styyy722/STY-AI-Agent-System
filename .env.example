# Claude / Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# Default Claude model
ANTHROPIC_MODEL=claude-sonnet-4-6

# Premium Claude model (used automatically for report mode)
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-7

# Default agent style
AGENT_STYLE=professional

# Default output format
OUTPUT_FORMAT=markdown

# Optional: override max tokens per API call (leave unset to use per-mode defaults)
# general=2000, finance=4000, data=6000, report=8000
# MAX_TOKENS=4000

# Daily API spend cap in USD (default: 5.00)
# The agent will refuse to make API calls once this limit is reached
# Run: sty-agent usage to see current spend
DAILY_BUDGET_USD=10.00
