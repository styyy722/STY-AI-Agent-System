# ─── LLM Provider ────────────────────────────────────────────────────────────
# Which AI provider to use: anthropic (default) or openai
LLM_PROVIDER=anthropic

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-7

# ─── OpenAI (fallback provider) ──────────────────────────────────────────────
# Only required if LLM_PROVIDER=openai
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# ─── Agent behaviour ─────────────────────────────────────────────────────────
AGENT_STYLE=professional
OUTPUT_FORMAT=markdown

# ─── Token limits ────────────────────────────────────────────────────────────
# Optional: override max tokens per API call (leave unset to use per-mode defaults)
# general=2000, finance=4000, data=6000, report=8000
# MAX_TOKENS=4000

# ─── Extended Thinking ───────────────────────────────────────────────────────
# Enables Claude to reason internally before answering (Claude only)
# Minimum: 1024 | Good starting point: 10000 | Max: 32000
# Leave unset (or 0) to disable.
# THINKING_BUDGET_TOKENS=10000

# Set to true to print thinking blocks to stderr (debugging only)
# LOG_THINKING=false

# ─── RAG ─────────────────────────────────────────────────────────────────────
RAG_ENABLED=true

# ─── Cost control ────────────────────────────────────────────────────────────
DAILY_BUDGET_USD=15.00
