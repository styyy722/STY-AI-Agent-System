# Claude / Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# Default Claude model
ANTHROPIC_MODEL=claude-sonnet-4-6

# Premium Claude model (used automatically for report mode)
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-7

# Default agent style
AGENT_STYLE=professional

# Default output format
OUTPUT_FORMAT=markdown

# Optional: override max tokens per API call (leave unset to use per-mode defaults)
# general=2000, finance=4000, data=6000, report=8000
# MAX_TOKENS=4000

# Extended Thinking — enables Claude to reason internally before answering
# Recommended for complex corporate tasks: finance modelling, risk analysis, business cases
# Minimum: 1024 | Good starting point: 10000 | Deep analysis: 16000 | Max: 32000
# Leave unset (or set to 0) to disable. When enabled, expect longer response times.
# THINKING_BUDGET_TOKENS=10000

# Set to true to print a preview of Claude thinking blocks to stderr (for debugging)
# LOG_THINKING=false

# RAG — Retrieval-Augmented Generation knowledge base
# The agent automatically indexes its outputs and searches past knowledge before each response
# Set to false to disable (useful when API costs are a concern or starting fresh)
RAG_ENABLED=true

# Daily API spend cap in USD (default: 5.00)
# The agent will refuse to make API calls once this limit is reached
# Run: sty-agent usage to see current spend
DAILY_BUDGET_USD=15.00
